<Window x:Class="RestaurantHR_App.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام إدارة الموارد البشرية للمطاعم 2026" Height="750" Width="1200"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen" 
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- الشريط الجانبي Sidebar -->
        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0" Padding="20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#38BDF8">
                        <TextBlock Text="🍔" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="شؤون الموظفين" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC"/>
                        <TextBlock Text="إدارة المطعم" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="القائمة الرئيسية" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="0,10,0,10"/>
                <Button Content="📊  لوحة التحكم" Style="{StaticResource PillButton}" Background="#38BDF8" Foreground="#0F172A" Margin="0,0,0,8"/>
                <Button Content="👥  دليل الموظفين" Style="{StaticResource PillButton}" Margin="0,0,0,8"/>
                <Button Content="⏱️  سجل الدوام والورديات" Style="{StaticResource PillButton}" Margin="0,0,0,8"/>
                <Button Content="💰  السُلف والرواتب" Style="{StaticResource PillButton}" Margin="0,0,0,8"/>
                <Button Content="📈  التقارير والإحصائيات" Style="{StaticResource PillButton}" Margin="0,0,0,8"/>
            </StackPanel>
        </Border>

        <!-- منطقة العمل الرئيسية -->
        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- الهيدر -->
            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="مرحباً بك مجدداً 👋" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="إليك نظرة عامة على انضباط ودوام فريق المطعم اليوم" FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>
                <Button Content="+ تسجيل حضور يدوي" Click="OpenAddAttendance_Click" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>

            <!-- البطاقات العلوية -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" Padding="18" Margin="0,0,10,0" BorderBrush="#F59E0B" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#FEF3C7" Margin="0,0,12,0">
                            <TextBlock Text="🏆" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="نجم الورديات (MVP)" FontSize="12" Foreground="#F59E0B" FontWeight="Bold"/>
                            <TextBlock Text="أحمد محمود (شيف)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" Padding="18" Margin="5,0,5,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#0284C7" Margin="0,0,12,0">
                            <TextBlock Text="👥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="الحضور اليوم" FontSize="12" Foreground="#94A3B8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding PresentToday}" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text=" / " FontSize="18" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalEmployees}" FontSize="18" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#1E293B" CornerRadius="16" Padding="18" Margin="10,0,0,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#059669" Margin="0,0,12,0">
                            <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="مؤشر الانضباط" FontSize="12" Foreground="#94A3B8"/>
                            <TextBlock Text="94% ممتاز" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- أزرار الفلترة والتصدير -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="12" Margin="0,0,0,15">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="التصفية:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,12,0"/>
                        <Button Content="اليوم" Click="FilterToday_Click" Style="{StaticResource PillButton}" Margin="0,0,8,0"/>
                        <Button Content="آخر 7 أيام" Click="Filter7Days_Click" Style="{StaticResource PillButton}" Margin="0,0,8,0"/>
                        <Button Content="آخر 30 يوم" Click="Filter30Days_Click" Style="{StaticResource PillButton}" Margin="0,0,15,0"/>
                        <DatePicker x:Name="DpStart" Width="120" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker x:Name="DpEnd" Width="120" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="تطبيق" Click="FilterCustom_Click" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>

                    <Button Content="📥 تصدير Excel" Click="ExportExcel_Click" Style="{StaticResource SuccessButton}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- الجدول -->
            <Border Grid.Row="3" Background="#1E293B" CornerRadius="12" Padding="10">
                <DataGrid x:Name="MainDataGrid" ItemsSource="{Binding FilteredAttendances}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                          RowHeight="42" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="35"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#334155"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="120"/>
                        <DataGridTextColumn Header="اسم الموظف" Binding="{Binding Employee.Name}" Width="*"/>
                        <DataGridTextColumn Header="وقت الدخول" Binding="{Binding CheckInTime, StringFormat=\{0:hh\\\\:mm\}}" Width="120"/>
                        <DataGridTextColumn Header="وقت الخروج" Binding="{Binding CheckOutTime, StringFormat=\{0:hh\\\\:mm\}}" Width="120"/>
                        <DataGridTextColumn Header="الساعات الإضافية" Binding="{Binding OvertimeHours}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>

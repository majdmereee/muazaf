<UserControl x:Class="RestaurantHR_App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F8"> <!-- لون خلفية عصري ومريح -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- قسم الإحصائيات العلوية -->
            <RowDefinition Height="Auto"/> <!-- قسم الفلاتر -->
            <RowDefinition Height="*"/>    <!-- جدول البيانات -->
        </Grid.RowDefinitions>

        <!-- الإحصائيات السريعة -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Border Background="White" CornerRadius="8" Padding="20" Margin="10" Width="200">
                <StackPanel>
                    <TextBlock Text="الموظفين (نشط)" FontSize="14" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalEmployees}" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>
            </Border>
            <!-- يمكنك تكرار الـ Border للحاضرين والغياب اليوم -->
        </StackPanel>

        <!-- فلاتر التواريخ وأزرار التصدير -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="آخر 7 أيام" Command="{Binding Filter7DaysCommand}" Margin="5" Padding="10,5"/>
            <Button Content="آخر 30 يوم" Command="{Binding Filter30DaysCommand}" Margin="5" Padding="10,5"/>
            <DatePicker x:Name="DpStart" Margin="5" Width="120"/>
            <DatePicker x:Name="DpEnd" Margin="5" Width="120"/>
            <Button Content="تطبيق مخصص" Margin="5" Padding="10,5"/>
            
            <!-- زر التصدير في أقصى اليسار -->
            <Button Content="تصدير إلى Excel" Command="{Binding ExportCommand}" Margin="50,5,5,5" Background="#27AE60" Foreground="White"/>
        </StackPanel>

        <!-- جدول البيانات (أسلوب Excel) -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredAttendances}" 
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="All" AlternatingRowBackground="#FAFAFA"
                  RowHeight="35" ColumnWidth="*">
            <DataGrid.Columns>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" />
                <DataGridTextColumn Header="رقم الموظف" Binding="{Binding EmployeeId}" />
                <DataGridTextColumn Header="وقت الدخول" Binding="{Binding CheckInTime}" />
                <DataGridTextColumn Header="وقت الخروج" Binding="{Binding CheckOutTime}" />
                <DataGridTextColumn Header="إضافي (ساعات)" Binding="{Binding OvertimeHours}" />
                <DataGridCheckBoxColumn Header="غياب؟" Binding="{Binding IsAbsent}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
